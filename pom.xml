<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Spring Boot parent: supplies the Spring Boot BOM (dependency management for Spring, HikariCP,
    the PostgreSQL driver, JUnit, AssertJ, ...) and pinned versions for every core Maven plugin.
    Versions that deviate from, or are not covered by, the Boot BOM are pinned in <properties> below.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>dev.alaka</groupId>
  <artifactId>alaka</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>Alaka</name>
  <description>Alaka: A Formally Verified, Double-Entry Financial Authority &amp; Spend Reservation Kernel for Autonomous Agents</description>

  <!--
    Single Maven module by design. The four subsystems are packages under dev.alaka, not modules:
      dev.alaka.core   (alaka-core)  gateway and execution orchestrator
      dev.alaka.nidhi  (nidhi)       double-entry PostgreSQL ledger kernel
      dev.alaka.mudra  (mudra)       capability mandate and drift engine
      dev.alaka.yaksha (yaksha)      rail adapter, outbox worker, zombie recovery sweeper
  -->

  <properties>
    <!-- Language level: Java 21 bytecode and API, enforced with javac's release flag so the build
         is correct on any JDK >= 21 (no toolchain / JDK 21 installation required). -->
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <start-class>dev.alaka.core.AlakaApplication</start-class>

    <!-- Build output directory. Override with -Dalaka.buildDir=target-<name> to run several
         builds of the same checkout side by side without them deleting each other's output. -->
    <alaka.buildDir>${project.basedir}/target</alaka.buildDir>

    <!-- Overrides of versions managed by the Spring Boot BOM (property names are Boot's own). -->
    <junit-jupiter.version>5.14.4</junit-jupiter.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <postgresql.version>42.7.14</postgresql.version>

    <!-- Not managed by the Spring Boot BOM. -->
    <jdbi.version>3.55.0</jdbi.version>
    <jqwik.version>1.10.2</jqwik.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.jdbi</groupId>
        <artifactId>jdbi3-bom</artifactId>
        <version>${jdbi.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Imported explicitly (same version properties the Boot BOM reads) so the JUnit and
           Testcontainers lines in use are visible here rather than implied by the parent. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-jupiter.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- alaka-core: HTTP entrypoint (version from the Spring Boot BOM). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- alaka-core: /actuator/health and /actuator/prometheus (versions from the Spring Boot BOM). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- nidhi: SQL access (versions from the jdbi3 BOM). -->
    <dependency>
      <groupId>org.jdbi</groupId>
      <artifactId>jdbi3-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jdbi</groupId>
      <artifactId>jdbi3-postgres</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jdbi</groupId>
      <artifactId>jdbi3-sqlobject</artifactId>
    </dependency>

    <!-- nidhi: connection pool (version from the Spring Boot BOM) and PostgreSQL JDBC driver. -->
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Test: JUnit 5 (Jupiter) and jqwik, both running on the JUnit Platform. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <version>${jqwik.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Test: Testcontainers (versions from the Testcontainers BOM). -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-toxiproxy</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <directory>${alaka.buildDir}</directory>
    <plugins>
      <!-- Fail fast on an unsuitable build environment and on non-reproducible dependency versions. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-environment</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
                <requireJavaVersion>
                  <version>[21,)</version>
                </requireJavaVersion>
                <requireReleaseDeps>
                  <message>SNAPSHOT dependencies are not allowed.</message>
                </requireReleaseDeps>
                <banDynamicVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <showWarnings>true</showWarnings>
          <showDeprecation>true</showDeprecation>
          <!-- Every javac lint category is on and any warning fails the build. -->
          <failOnWarning>true</failOnWarning>
          <compilerArgs>
            <arg>-Xlint:all</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!--
        Surefire runs on the JUnit Platform, which discovers every engine on the test classpath
        (junit-jupiter for @Test, jqwik for @Property). The includes add jqwik's conventional
        *Properties suffix to Surefire's default class-name patterns.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/Test*.java</include>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*TestCase.java</include>
            <include>**/*Properties.java</include>
          </includes>
        </configuration>
      </plugin>

      <!-- Repackages the jar as an executable Spring Boot jar (main class: ${start-class}). -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
