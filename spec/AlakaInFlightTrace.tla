------------------------- MODULE AlakaInFlightTrace -------------------------
(***************************************************************************)
(* Trace validation: checks that recorded executions of the Java engine    *)
(* against PostgreSQL and the simulated rail are behaviours of             *)
(* AlakaInFlight.                                                          *)
(*                                                                         *)
(* AlakaTraceData (generated by the property suite) defines Traces, a      *)
(* sequence of recorded runs.  Each run is a sequence of abstract states,  *)
(* one per observable step of the implementation: after every engine call, *)
(* every rail call, and every rail-side event the test drives.  An         *)
(* abstract state gives a value to every variable of AlakaInFlight; the    *)
(* mapping from database rows and rail state is documented in              *)
(* dev.alaka.property.RefinementTracer.                                    *)
(*                                                                         *)
(* A run is accepted only if its first state satisfies Init and every      *)
(* consecutive pair of states satisfies [Next]_vars: either one action of  *)
(* the protocol, with the unsafe constants FALSE, or a step that changes   *)
(* nothing.  TLC walks every run; a run whose next recorded state is not a *)
(* legal successor leaves TLC with no successor, which TLC reports as a    *)
(* deadlock naming the run (t) and the step (i).                           *)
(***************************************************************************)
EXTENDS AlakaInFlight, AlakaTraceData, Sequences

VARIABLES t, i

Is(s) ==
    /\ mandate_status = s.ms
    /\ bal_available = s.av
    /\ bal_held = s.he
    /\ bal_settled = s.se
    /\ intents = s.it
    /\ wire_confirm = s.wc
    /\ rail_pi_state = s.rp
    /\ rail_charged = s.rc
    /\ cancel_resp = s.cr

Becomes(s) ==
    /\ mandate_status' = s.ms
    /\ bal_available' = s.av
    /\ bal_held' = s.he
    /\ bal_settled' = s.se
    /\ intents' = s.it
    /\ wire_confirm' = s.wc
    /\ rail_pi_state' = s.rp
    /\ rail_charged' = s.rc
    /\ cancel_resp' = s.cr

TraceInit ==
    /\ t \in DOMAIN Traces
    /\ i = 1
    /\ Is(Traces[t][1])
    /\ Init

TraceNext ==
    \/ /\ i < Len(Traces[t])
       /\ i' = i + 1
       /\ t' = t
       /\ Becomes(Traces[t][i + 1])
       /\ [Next]_vars
    \/ /\ i = Len(Traces[t])
       /\ UNCHANGED <<t, i, vars>>

TraceSpec == TraceInit /\ [][TraceNext]_<<t, i, vars>>
=============================================================================
